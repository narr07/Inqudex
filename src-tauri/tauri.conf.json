{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Inqudex",
	"version": "0.1.0",
	"identifier": "com.narr07.inqudex",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "bun run generate",
		"frontendDist": "../.output/public"
	},
	"app": {
		"windows": [
			{
				"title": "Inqudex",
				"width": 1366,
				"height": 768,
				"minWidth": 420,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"maximized": true
			}
		],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "Inqudex Desktop SEO & Traffic Engine",
		"longDescription": "Inqudex: Desktop toolkit for SEO automation, search console analytics, batch indexing, and website traffic simulation.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
